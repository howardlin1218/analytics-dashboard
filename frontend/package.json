{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:assets": "node -e \"const fs=require('fs');const p='../public_html/assets';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});\"",
    "build": "npm run clean:assets && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
